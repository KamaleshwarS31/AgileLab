# Supabase + Upstash Configuration
# Copy this to .env and fill in your values

# OpenWeather API Key (get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Supabase PostgreSQL Database URL
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.xxxxx.supabase.co:5432/postgres

# Upstash Redis URL
# Get from: Upstash Dashboard → Your Database → Redis URL
# Format: redis://default:xxxxx@xxxxx.upstash.io:6379
REDIS_URL=redis://default:your-token@xxxxx.upstash.io:6379

# CORS Origins (your frontend URL)
CORS_ORIGINS=http://localhost:3000,https://your-frontend-url.vercel.app

# Security
SECRET_KEY=your-secret-key-change-in-production

# Cache Settings
CACHE_EXPIRATION=300
